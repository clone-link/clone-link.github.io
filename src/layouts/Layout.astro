---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { supportedLanguages, type SupportedLanguageCode } from '../i18n/languages';
import { useTranslations, getLocalizedPath } from '../i18n/utils';

interface Props {
  lang: SupportedLanguageCode;
  title?: string;
  description?: string;
}

const { lang, title: customTitle, description: customDescription } = Astro.props;
const t = useTranslations(lang);

const title = customTitle || t.meta.title;
const description = customDescription || t.meta.description;
const keywords = t.meta.keywords;

const pathname = Astro.url.pathname;
const siteUrl = 'https://clone-link.github.io';
const canonicalUrl = `${siteUrl}${pathname.replace(/\/+$/, '') || '/'}`;

// 1. WebApplication & SoftwareApplication Schema
const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'CloneLink',
  alternateName: 'Clone Link Git Utility',
  url: siteUrl,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  browserRequirements: 'Requires JavaScript. Modern browser supported.',
  description: description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  author: {
    '@type': 'Person',
    name: 'Kishara Dilshan',
    url: 'https://buymeacoffee.com/kisharadilz',
  },
  featureList: [
    'Chained Git terminal commands (clone + cd + VS Code/npm)',
    'Browser-side subfolder ZIP packaging with zero server dependencies',
    'Shallow clone flag (--depth 1) toggle',
    'Multi-protocol support: HTTPS, SSH, GitHub CLI',
    'Multi-package manager script chains: npm, pnpm, yarn, bun',
    'Single organization auto-expansion to GitHub Pages root repository',
    '100% client-side privacy with zero server logs',
  ],
  keywords: keywords,
};

// 2. WebSite Schema with SearchAction
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CloneLink',
  url: `${siteUrl}/`,
  description: description,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
};

// 3. BreadcrumbList Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'CloneLink',
      item: `${siteUrl}/`,
    },
    ...(lang !== 'en'
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: supportedLanguages.find((l) => l.code === lang)?.label || lang.toUpperCase(),
            item: `${siteUrl}/${lang}`,
          },
        ]
      : []),
  ],
};

// 4. FAQPage Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: t.faq.q1,
      acceptedAnswer: {
        '@type': 'Answer',
        text: t.faq.a1,
      },
    },
    {
      '@type': 'Question',
      name: t.faq.q2,
      acceptedAnswer: {
        '@type': 'Answer',
        text: t.faq.a2,
      },
    },
    {
      '@type': 'Question',
      name: t.faq.q3,
      acceptedAnswer: {
        '@type': 'Answer',
        text: t.faq.a3,
      },
    },
    {
      '@type': 'Question',
      name: t.faq.q4,
      acceptedAnswer: {
        '@type': 'Answer',
        text: t.faq.a4,
      },
    },
    {
      '@type': 'Question',
      name: t.faq.q5,
      acceptedAnswer: {
        '@type': 'Answer',
        text: t.faq.a5,
      },
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3LJL2YJVCB" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3LJL2YJVCB');
    </script>

    <!-- Theme Colors & PWA Capabilities -->
    <meta name="theme-color" content="#FAFAFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#090D16" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="CloneLink" />

    <!-- Technical SEO Metadata -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Kishara Dilshan" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Hreflang Tags for all 7 Languages -->
    {supportedLanguages.map((l) => (
      <link
        rel="alternate"
        hreflang={l.code}
        href={`${siteUrl}${getLocalizedPath(pathname, l.code as SupportedLanguageCode)}`}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="CloneLink" />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CloneLink - Smart Git Clone Command Generator & Subfolder Downloader" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
    <meta name="twitter:image:alt" content="CloneLink - Smart Git Clone Command Generator & Subfolder Downloader" />
    <meta name="twitter:creator" content="@kisharadilz" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(webAppSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- Dark/Light Theme Script (Instant Execution to prevent FOUT) -->
    <script is:inline>
      (function () {
        try {
          const theme = localStorage.getItem('theme') || 'light';
          if (theme === 'dark') {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Google Fonts Preconnect & Inter / JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-clonelink-lightBg dark:bg-clonelink-darkBg text-gray-900 dark:text-gray-100 min-h-screen flex flex-col font-sans antialiased selection:bg-clonelink-indigo/20 dark:selection:bg-clonelink-emerald/30 transition-colors duration-200">
    <!-- Accessibility Skip to Main Content Link -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 px-4 py-2 bg-clonelink-indigo text-white font-semibold rounded-lg shadow-lg focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-clonelink-indigo">
      Skip to main content
    </a>

    <Navbar currentLang={lang} currentPath={pathname} />

    <main id="main-content" class="flex-1 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12" role="main">
      <slot />
    </main>

    <Footer currentLang={lang} />
  </body>
</html>
