---
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguageCode } from '../i18n/languages';

interface Props {
  currentLang: SupportedLanguageCode;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-clonelink-lightBorder dark:border-clonelink-darkBorder bg-white/50 dark:bg-clonelink-darkBg/50 backdrop-blur-sm py-12 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      <!-- Brand & Tagline -->
      <div class="flex flex-col items-center md:items-start space-y-1.5 text-center md:text-left">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-lg bg-clonelink-indigo dark:bg-clonelink-emerald text-white flex items-center justify-center font-bold text-xs">
            C
          </div>
          <span class="font-extrabold text-base tracking-tight text-gray-900 dark:text-white">
            Clone<span class="text-clonelink-indigo dark:text-clonelink-emerald">Link</span>
          </span>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 max-w-sm">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Links & Support CTA -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-medium">
        <a
          href="https://buymeacoffee.com/kisharadilz"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-amber-700 dark:text-amber-300 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors"
        >
          <span>☕</span>
          <span>{t.footer.supportCta}</span>
        </a>

        <a
          href="https://github.com/clone-link/clone-link.github.io"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
          </svg>
          <span>{t.footer.githubCta}</span>
        </a>
      </div>
    </div>

    <div class="mt-8 pt-6 border-t border-gray-200/60 dark:border-gray-800/60 flex flex-col sm:flex-row items-center justify-between gap-3 text-center text-xs text-gray-500 dark:text-gray-400">
      <div>
        © {year} CloneLink. {t.footer.creator}
      </div>
      <div class="text-[11px] font-mono text-gray-400 dark:text-gray-400">
        {t.footer.privacy}
      </div>
    </div>
  </div>
</footer>
