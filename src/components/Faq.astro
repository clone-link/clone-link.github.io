---
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguageCode } from '../i18n/languages';

interface Props {
  currentLang: SupportedLanguageCode;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);

const faqItems = [
  { q: t.faq.q1, a: t.faq.a1 },
  { q: t.faq.q2, a: t.faq.a2 },
  { q: t.faq.q3, a: t.faq.a3 },
  { q: t.faq.q4, a: t.faq.a4 },
  { q: t.faq.q5, a: t.faq.a5 },
];
---

<section class="mt-20 sm:mt-28">
  <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
      {t.faq.title}
    </h2>
  </div>

  <div class="max-w-3xl mx-auto space-y-4">
    {faqItems.map((item, index) => (
      <details class="group rounded-2xl bg-white dark:bg-clonelink-darkSurface border border-clonelink-lightBorder dark:border-clonelink-darkBorder p-5 sm:p-6 transition-all duration-200 open:shadow-clean-md">
        <summary class="flex items-center justify-between cursor-pointer list-none select-none font-bold text-sm sm:text-base text-gray-900 dark:text-white group-hover:text-clonelink-indigo dark:group-hover:text-clonelink-emerald transition-colors">
          <span>{item.q}</span>
          <span class="ml-4 flex-shrink-0 text-gray-400 group-hover:text-clonelink-indigo dark:group-hover:text-clonelink-emerald transition-transform duration-200 group-open:rotate-180">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-800 text-xs sm:text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
          {item.a}
        </div>
      </details>
    ))}
  </div>
</section>
