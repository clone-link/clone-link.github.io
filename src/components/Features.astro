---
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguageCode } from '../i18n/languages';

interface Props {
  currentLang: SupportedLanguageCode;
}

const { currentLang } = Astro.props;
const t = useTranslations(currentLang);
---

<section class="mt-20 sm:mt-28">
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <h2 class="text-2xl sm:text-3xl font-extrabold text-gray-900 dark:text-white tracking-tight">
      {t.features.title}
    </h2>
    <p class="mt-3 text-sm sm:text-base text-gray-600 dark:text-gray-400">
      {t.features.subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Feature 1: Privacy -->
    <div class="p-6 rounded-2xl bg-white dark:bg-clonelink-darkSurface border border-clonelink-lightBorder dark:border-clonelink-darkBorder shadow-clean hover:border-clonelink-indigo/40 dark:hover:border-clonelink-emerald/40 transition-all">
      <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-indigo-950/60 text-clonelink-indigo dark:text-indigo-400 flex items-center justify-center mb-4">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">
        {t.features.f1Title}
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        {t.features.f1Desc}
      </p>
    </div>

    <!-- Feature 2: Deep URL Parser -->
    <div class="p-6 rounded-2xl bg-white dark:bg-clonelink-darkSurface border border-clonelink-lightBorder dark:border-clonelink-darkBorder shadow-clean hover:border-clonelink-indigo/40 dark:hover:border-clonelink-emerald/40 transition-all">
      <div class="w-10 h-10 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 text-clonelink-emerald dark:text-emerald-400 flex items-center justify-center mb-4">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">
        {t.features.f2Title}
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        {t.features.f2Desc}
      </p>
    </div>

    <!-- Feature 3: Browser In-Memory ZIP -->
    <div class="p-6 rounded-2xl bg-white dark:bg-clonelink-darkSurface border border-clonelink-lightBorder dark:border-clonelink-darkBorder shadow-clean hover:border-clonelink-indigo/40 dark:hover:border-clonelink-emerald/40 transition-all">
      <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/60 text-amber-500 flex items-center justify-center mb-4">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">
        {t.features.f3Title}
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        {t.features.f3Desc}
      </p>
    </div>

    <!-- Feature 4: Multi-protocol & Package Managers -->
    <div class="p-6 rounded-2xl bg-white dark:bg-clonelink-darkSurface border border-clonelink-lightBorder dark:border-clonelink-darkBorder shadow-clean hover:border-clonelink-indigo/40 dark:hover:border-clonelink-emerald/40 transition-all">
      <div class="w-10 h-10 rounded-xl bg-indigo-50 dark:bg-emerald-950/60 text-clonelink-indigo dark:text-clonelink-emerald flex items-center justify-center mb-4">
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <h3 class="text-base font-bold text-gray-900 dark:text-white mb-1.5">
        {t.features.f4Title}
      </h3>
      <p class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
        {t.features.f4Desc}
      </p>
    </div>
  </div>
</section>
